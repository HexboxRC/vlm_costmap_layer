<?xml version="1.0"?>
<robot name="semantic_nav_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Known extrinsics (documented, not guessed) =================
       All numbers below are the single source of truth for this robot's geometry.
       robot_state_publisher publishes the resulting TF tree from these joints;
       sdformat_urdf converts this same file (gazebo tags included) into the SDF
       model spawned into gz-sim — one file, two consumers, no drift between them.
  -->
  <xacro:property name="chassis_x" value="0.30"/>
  <xacro:property name="chassis_y" value="0.30"/>
  <xacro:property name="chassis_z" value="0.10"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.30"/>
  <!-- base_link origin sits at wheel-axle height above base_footprint (ground) -->
  <xacro:property name="axle_height" value="${wheel_radius}"/>
  <!-- chassis box center, relative to base_link -->
  <xacro:property name="chassis_z_offset" value="0.10"/>
  <xacro:property name="caster_x" value="-0.12"/>

  <xacro:property name="lidar_xyz" value="0 0 0.15"/>
  <xacro:property name="camera_xyz" value="0.15 0 0.10"/>
  <!-- REP-103 mounting frame -> optical frame (z-forward, x-right, y-down) -->
  <xacro:property name="optical_rpy" value="${-pi/2} 0 ${-pi/2}"/>

  <material name="chassis_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="wheel_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="sensor_orange"><color rgba="0.9 0.5 0.1 1"/></material>

  <!-- ================= Links ================= -->

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_height}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
      </inertial>
    </link>
    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="0 ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel prefix="left" y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- Passive rear caster: fixed (skid) sphere, not an actuated joint.
       Same ground contact height as the drive wheels so the chassis
       stays level. Low friction so it doesn't fight the diff drive. -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${wheel_radius}"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <geometry><sphere radius="${wheel_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- Lidar mount: centered on top of the chassis, above chassis-top
       height, for an unobstructed 360 degree sweep. -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="sensor_orange"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- Camera mount: front face of the chassis, facing +x (forward),
       REP-103 mounting-frame orientation (x-forward, z-up). -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
      <material name="sensor_orange"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: what camera_info/image headers actually reference
       (z-forward, x-right, y-down) — required to project 3D points
       into image pixels correctly later. Zero translation from
       camera_link, rotation only. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${optical_rpy}"/>
  </joint>

  <!-- ================= Sensors (gz-sim SDF passthrough) ================= -->

  <gazebo reference="lidar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <!-- Without this, gz-sensors defaults the scan's frame_id to a
           fully-scoped name (e.g. "semantic_nav_robot/base_footprint/
           gpu_lidar" or "model::link::sensor" depending on how the
           model was loaded) instead of the URDF link name — which
           robot_state_publisher's TF tree has no entry for, so Nav2's
           costmaps see "two unconnected TF trees" and silently drop
           every scan. Discovered via Milestone 5's full bringup log,
           not assumed. -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <!-- Same convention proven in Milestone 2: bit 0 only, so any
             visual with visibility_flags=2 (e.g. a glass wall) is
             excluded from this lidar's render pass. -->
        <visibility_mask>1</visibility_mask>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <topic>camera</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.4</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
        <!-- Bits 0+1 (see Milestone 2 for why not the 0xFFFFFFFF
             default): sees both plain objects and glass. -->
        <visibility_mask>3</visibility_mask>
        <!-- image/camera_info headers use this frame_id, not
             camera_link — matches the camera_optical_frame link/joint
             defined above so a consumer projecting points has an
             actual TF to look up. -->
        <optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= Drivetrain plugins (model-level) ================= -->

  <gazebo>
    <!-- Evaluation only: never bridged onto /tf or fed to localization. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>20</update_frequency>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
      <topic>joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

</robot>
